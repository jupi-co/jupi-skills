.DS_Store
__pycache__/
*.pyc

# Harness-owned local settings + consumer-side config, never committed here
# (documented for contributors who test locally). Glob, not per-file: a
# setup.local.json holding a live Neon connection string and a Supermemory key
# once sat here untracked-but-unignored for five days.
.claude/*.local.json
.claude/settings.local.json

# proactive-jupi: instance state & secrets — never commit.
# (the .env.template beside it IS committed and must never hold a real value)
.proactive-jupi/config.local.json
.proactive-jupi/*.local.json
.proactive-jupi/.env

# playbook-jupi: bench/instance state & secrets (config, local playbook
# projection, run scratch) — never commit any of it. The committed template is
# dev/config.template.json and must never hold a real value; the dev mailbox
# address and the Neon string exist ONLY in the local copy.
.playbook-jupi/

# proactive-jupi: shared/ runtime deps (installed at runtime by ensure-deps.sh, not vendored)
node_modules/
package-lock.json

# Build artifacts (regenerated by tools/package-plugin.sh / the post-commit hook)
dist/

# Eval run artifacts — regenerable, often large, sometimes carry real signal content
evals/*/workspace/
