.DS_Store
__pycache__/
*.pyc

# Consumer-side, never committed here (documented for contributors who test locally)
.claude/settings.local.json
.claude/jupi.local.json

# proactive-jupi: instance state & secrets — never commit.
.proactive-jupi/config.local.json
.proactive-jupi/*.local.json
.proactive-jupi/.env
.claude/proactive-jupi.local.json

# proactive-jupi: shared/ runtime deps (installed at runtime by ensure-deps.sh, not vendored)
node_modules/
package-lock.json

# Build artifacts (regenerated by tools/package-plugin.sh / the post-commit hook)
dist/

# Eval run artifacts — regenerable, often large, sometimes carry real signal content
evals/*/workspace/
